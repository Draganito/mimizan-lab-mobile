<?xml version="1.0" encoding="utf-8"?>
<!--
    The purchase cache is Play's answer for this device and account; a
    copy carried to another phone is not one. Play is asked again there.
    Grade, Peak and the standing filter live in mimizan.xml — they are
    this phone's darkroom, not something to restore onto another device
    and not a way to carry a forged fullres flag. The raw frames live in
    the cache directory, which is never backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="entitlements.xml" />
        <exclude domain="sharedpref" path="mimizan.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="entitlements.xml" />
        <exclude domain="sharedpref" path="mimizan.xml" />
    </device-transfer>
</data-extraction-rules>
